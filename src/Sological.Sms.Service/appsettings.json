{
  "SologicalSms": {
    "ConnectionStrings": {
      "DefaultConnection": "Host=localhost;Database=sologicalsms;Username=postgres;Password=postgres"
    },
    "RateLimits": {
      "Enabled": true,
      "SendPerSecond": 5,
      "SendBurst": 10,
      "GlobalPerMinute": 120,
      "IngressPerMinute": 300,
      "MaxRequestBodyBytes": 65536
    },
    "Breaker": {
      "Enabled": true,
      "UnmatchedThreshold": 10,
      "WindowMinutes": 5,
      "AlertNumber": "",
      "AlertOriginator": "SoLogical"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
